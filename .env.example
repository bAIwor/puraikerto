# GMI Cloud (MiniMax M3)
# Get your free API key at: https://console.gmicloud.ai/
# Free during MiniMaxathon campaign (14 days)
GMI_API_KEY=your_gmi_api_key_here
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=MiniMaxAI/MiniMax-M3

# Curation
CURATION_INTERVAL_HOURS=1
CACHE_TTL_HOURS=24
GRID_SIZE=9
DOMAIN_FOCUS=ai

# Optional: RSS feed tambahan (satu URL per baris, format plain)
# RSS_FEEDS=https://hnrss.org/frontpage
# RSS_FEEDS=https://hnrss.org/newest?q=AI+OR+LLM+OR+GPT+OR+Claude
